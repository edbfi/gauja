{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>edbfi/automation:default#v1.0.0"
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "History scanner version and archive checksum are reviewed together.",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "GITLEAKS_VERSION:\\s*(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/ci/apple-tools\\.env$/"
      ],
      "matchStrings": [
        "# renovate: depName=(?<depName>[^\\s]+)\\s+[A-Z_]+=(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/codegen/versions\\.env$/"
      ],
      "matchStrings": [
        "(?:^|\\n)OPENAPI_GENERATOR_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "OpenAPITools/openapi-generator",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/codegen/versions\\.env$/"
      ],
      "matchStrings": [
        "(?:^|\\n)SWIFT_OPENAPI_GENERATOR_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "apple/swift-openapi-generator",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Compose Rules 0.5+ requires Detekt 2 alpha; retain the stable Detekt 1.23.8-compatible line until a coordinated migration.",
      "matchPackageNames": ["io.nlopez.compose.rules:detekt"],
      "allowedVersions": "<0.5.0"
    },
    {
      "description": "Kotlin 2.4.20 and dependency-analysis 3.19.1 support AGP through 9.3.1; review these tools together before raising the ceiling.",
      "matchPackageNames": ["com.android.application", "com.android.library", "com.android.tools.build:gradle"],
      "allowedVersions": "<=9.3.1"
    },
    {
      "description": "The history scanner version and checked archive hash must change together.",
      "matchPackageNames": [
        "gitleaks/gitleaks"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "groupName": "gitleaks"
    },
    {
      "description": "Generated clients, mobile compiler/plugin graphs, and deployment floors require native compatibility review for major upgrades.",
      "matchManagers": [
        "gradle",
        "gradle-wrapper",
        "swift"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep the Swift generator manifest and validation pin together; regenerate its checked output and resolved graph.",
      "matchPackageNames": [
        "apple/swift-openapi-generator"
      ],
      "groupName": "Swift OpenAPI generator",
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Review the Java generator archive hash and regenerate its checked output.",
      "matchPackageNames": [
        "OpenAPITools/openapi-generator"
      ],
      "groupName": "Java OpenAPI generator",
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
